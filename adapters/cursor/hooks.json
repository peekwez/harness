{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {"command": "python3 \"${HARNESS_DIR}/adapters/cursor/adapter.py\""}
    ],
    "beforeSubmitPrompt": [
      {"command": "python3 \"${HARNESS_DIR}/adapters/cursor/adapter.py\""}
    ],
    "preToolUse": [
      {"command": "python3 \"${HARNESS_DIR}/adapters/cursor/adapter.py\"",
       "matcher": "Write|Delete",
       "failClosed": true}
    ],
    "afterFileEdit": [
      {"command": "python3 \"${HARNESS_DIR}/adapters/cursor/adapter.py\""}
    ],
    "stop": [
      {"command": "python3 \"${HARNESS_DIR}/adapters/cursor/adapter.py\""}
    ],
    "preCompact": [
      {"command": "python3 \"${HARNESS_DIR}/adapters/cursor/adapter.py\""}
    ]
  }
}
